rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function ownsSalon(salonId) {
      return signedIn() &&
        firestore.get(
          /databases/(default)/documents/salons/$(salonId)
        ).data.ownerUid == request.auth.uid;
    }

    function ownerSalonId(salonId) {
      return signedIn() && salonId == 'salon-' + request.auth.uid;
    }

    match /salons/{salonId}/photos/{photoName} {
      allow read: if true;
      allow create, update: if (ownsSalon(salonId) || ownerSalonId(salonId)) &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if ownsSalon(salonId) || ownerSalonId(salonId);
    }

    // Payment QR images are not public salon media. The owner uploads and
    // manages them; authorized backend services use their private record.
    match /salons/{salonId}/payments/{paymentFile} {
      allow read: if ownsSalon(salonId);
      allow create, update: if ownsSalon(salonId) &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if ownsSalon(salonId);
    }

    match /customers/{customerId}/profile/{photoName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == customerId &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == customerId;
    }

    match /customers/{customerId}/styles/{photoName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == customerId &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if signedIn() && request.auth.uid == customerId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
